{"config": {"stepGap": 200},
 "steps": [
  {"log": "Sequencer entry whose To panel was deleted (review finding 1). Fixture insp-aaa: panel 1 TurbineL, panel 2 ---. Make panels TurbineL, GlassCockpitL, GlassCockpitLL; a sequencer entry SA up: TurbineL -> GlassCockpitLL; delete GlassCockpitLL; fire SA with window 1 on TurbineL. Window 1 must still draw a panel. FAILS until the sequencer follows panel deletes"},
  {"waitForm": true},
  {"waitSub": 1},

  {"log": "Panels: rows are header (row 1) then one row per panel; panel n's image selectbox is component #(3n+2)"},
  {"link": "Panels >>"},
  {"waitSub": 106},
  {"expect": "#5", "value": "TurbineL"},
  {"set": "#8", "value": "GlassCockpitL"},
  {"expect": "#8", "value": "GlassCockpitL"},
  {"key": "KEY_3"},
  {"waitSub": 106},
  {"set": "#11", "value": "GlassCockpitLL"},
  {"expect": "#11", "value": "GlassCockpitLL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"log": "Edit Links: entry 1 is #2 switch, #3 trigger, #4 From, #5 To"},
  {"link": "Edit Links >>"},
  {"waitSub": 105},
  {"log": "InsP wants the switch held at its active position while assigning it"},
  {"setInput": "SA", "value": 1},
  {"set": "#2", "value": "SA"},
  {"waitMessage": "do not move switch", "absent": true, "for": "1s"},
  {"setInput": "SA", "value": -1},
  {"set": "#3", "value": "+"},
  {"set": "#4", "value": "TurbineL"},
  {"set": "#5", "value": "GlassCockpitLL"},
  {"expect": "#4", "value": "TurbineL"},
  {"expect": "#5", "value": "GlassCockpitLL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"log": "delete panel 3 (GlassCockpitLL): focus its row (row 4), F4"},
  {"link": "Panels >>"},
  {"waitSub": 106},
  {"focus": 4},
  {"key": "KEY_4"},
  {"waitSub": 106},
  {"expect": "#5", "value": "TurbineL"},
  {"expect": "#8", "value": "GlassCockpitL"},
  {"expectNoText": "GlassCockpitLL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"log": "what the sequencer screen shows for the entry now"},
  {"link": "Edit Links >>"},
  {"waitSub": 105},
  {"expect": "#4", "value": "TurbineL"},
  {"log": "To now shows '+' (next panel), but in flight the entry still names the deleted panel"},
  {"expect": "#5", "value": "+"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "in flight: window 1 on panel 1 (TurbineL), then SA up"},
  {"waitTelem": 1},
  {"wait": 1500},
  {"expectImage": "TurbineL", "win": 1},
  {"setInput": "SA", "value": 1},
  {"wait": 1500},
  {"log": "window 1 must still draw a panel image (it goes blank when the entry names a deleted panel)"},
  {"expectImage": ".png", "win": 1}
 ]}
