{"config": {"stepGap": 200},
 "steps": [
  {"log": "Sequencer entry whose To panel was deleted (review finding 1). Fixture insp-aaa: panel 1 TurbineL, panel 2 ---. Make panels TurbineL, GlassCockpitL, GlassCockpitLL; a sequencer entry SA up: TurbineL -> GlassCockpitLL; delete GlassCockpitLL; fire SA with window 1 on TurbineL. Since 0.95 the delete removes the entry (with a message), so SA does nothing and window 1 stays on TurbineL. Before, the entry kept naming the deleted panel and SA blanked window 1"},
  {"waitForm": true},
  {"waitSub": 1},

  {"log": "Panels: rows are header (row 1) then one row per panel; panel n's image selectbox is component #(4n+2) (every add* call takes an index, rows too, from 0)"},
  {"link": "Panels >>"},
  {"waitSub": 106},
  {"expect": "#6", "value": "TurbineL"},
  {"set": "#10", "value": "GlassCockpitL"},
  {"expect": "#10", "value": "GlassCockpitL"},
  {"key": "KEY_3"},
  {"waitSub": 106},
  {"set": "#14", "value": "GlassCockpitLL"},
  {"expect": "#14", "value": "GlassCockpitLL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"log": "Edit Links: entry 1 is #3 switch, #4 trigger, #5 From, #6 To (entry j: #(5j-2)..#(5j+1))"},
  {"link": "Edit Links >>"},
  {"waitSub": 105},
  {"log": "InsP wants the switch held at its active position while assigning it"},
  {"setInput": "SA", "value": 1},
  {"set": "#3", "value": "SA"},
  {"waitMessage": "do not move switch", "absent": true, "for": "1s"},
  {"setInput": "SA", "value": -1},
  {"set": "#4", "value": "+"},
  {"set": "#5", "value": "TurbineL"},
  {"set": "#6", "value": "GlassCockpitLL"},
  {"expect": "#5", "value": "TurbineL"},
  {"expect": "#6", "value": "GlassCockpitLL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"log": "delete panel 3 (GlassCockpitLL): focus its row (row 4), F4"},
  {"link": "Panels >>"},
  {"waitSub": 106},
  {"focus": 4},
  {"key": "KEY_4"},
  {"waitMessage": "Removed 1 sequencer entry for GlassCockpitLL"},
  {"waitSub": 106},
  {"expect": "#6", "value": "TurbineL"},
  {"expect": "#10", "value": "GlassCockpitL"},
  {"expectNoText": "GlassCockpitLL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"log": "the entry is gone: the fixture's 2 entries were entry 1 (now SA, deleted) and entry 2, so 1 is left"},
  {"link": "Edit Links >>"},
  {"waitSub": 105},
  {"expectNoText": "GlassCockpitLL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "in flight: window 1 on panel 1 (TurbineL), then SA up"},
  {"waitTelem": 1},
  {"wait": 1500},
  {"expectImage": "TurbineL", "win": 1},
  {"setInput": "SA", "value": 1},
  {"wait": 1500},
  {"waitMessage": "switching to", "absent": true, "for": "1s", "anyTime": true},
  {"log": "window 1 is still on TurbineL"},
  {"expectImage": "TurbineL", "win": 1}
 ]}
