{"config": {"stepGap": 200},
 "steps": [
  {"log": "Panel numbering as panels are added and deleted: the image list, the Win 1 / Win 2 panel numbers and the selected panel must stay in step. Fixture insp-aaa: panel 1 TurbineL, panel 2 ---. Panels form 106: panel n's row is n+1, its image selectbox #(4n+2)"},
  {"waitForm": true},
  {"waitSub": 1},
  {"link": "Panels >>"},
  {"waitSub": 106},

  {"log": "build 4 panels: TurbineL, GlassCockpitL, GlassCockpitLL, ConcentricL"},
  {"set": "#10", "value": "GlassCockpitL"},
  {"key": "KEY_3"},
  {"waitSub": 106},
  {"expectState": "insp.settings.selectedPanel", "value": 3},
  {"set": "#14", "value": "GlassCockpitLL"},
  {"key": "KEY_3"},
  {"waitSub": 106},
  {"set": "#18", "value": "ConcentricL"},
  {"expectState": "insp.panelImages.1.instImage", "value": "TurbineL"},
  {"expectState": "insp.panelImages.2.instImage", "value": "GlassCockpitL"},
  {"expectState": "insp.panelImages.3.instImage", "value": "GlassCockpitLL"},
  {"expectState": "insp.panelImages.4.instImage", "value": "ConcentricL"},
  {"expectState": "count.panels", "value": 4},
  {"expectState": "insp.settings.selectedPanel", "value": 4},

  {"log": "a duplicate image is refused: panel 2 keeps GlassCockpitL"},
  {"set": "#10", "value": "TurbineL", "noReadback": true},
  {"waitMessage": "InsP: image is panel 1"},
  {"waitSub": 106},
  {"expect": "#10", "value": "GlassCockpitL"},
  {"expectState": "insp.panelImages.2.instImage", "value": "GlassCockpitL"},

  {"log": "Win 2 on panel 3, Win 1 on panel 4"},
  {"focus": 4},
  {"key": "KEY_2"},
  {"waitSub": 106},
  {"focus": 5},
  {"key": "KEY_1"},
  {"waitSub": 106},
  {"expectState": "insp.settings.window1Panel", "value": 4},
  {"expectState": "insp.settings.window2Panel", "value": 3},

  {"log": "delete panel 2 (no window on it): the panels after it move up, and so do the window and selected numbers"},
  {"focus": 3},
  {"key": "KEY_4"},
  {"waitSub": 106},
  {"waitMessage": "panel deleted", "absent": true, "for": "1s", "anyTime": true},
  {"expectState": "insp.panelImages.1.instImage", "value": "TurbineL"},
  {"expectState": "insp.panelImages.2.instImage", "value": "GlassCockpitLL"},
  {"expectState": "insp.panelImages.3.instImage", "value": "ConcentricL"},
  {"expectState": "count.panels", "value": 3},
  {"expect": "#6", "value": "TurbineL"},
  {"expect": "#10", "value": "GlassCockpitLL"},
  {"expect": "#14", "value": "ConcentricL"},
  {"expectState": "insp.settings.window1Panel", "value": 3},
  {"expectState": "insp.settings.window2Panel", "value": 2},
  {"expectState": "insp.settings.selectedPanel", "value": 3},

  {"log": "delete window 2's panel (2, GlassCockpitLL): window 2 goes to panel 2, now ConcentricL, the panel window 1 shows (finding 3: same panel in both is fine)"},
  {"focus": 3},
  {"key": "KEY_4"},
  {"waitMessage": "InsP: W2 panel deleted"},
  {"waitSub": 106},
  {"expectState": "insp.panelImages.1.instImage", "value": "TurbineL"},
  {"expectState": "insp.panelImages.2.instImage", "value": "ConcentricL"},
  {"expectState": "insp.settings.window1Panel", "value": 2},
  {"expectState": "insp.settings.window2Panel", "value": 2},
  {"expectState": "insp.settings.selectedPanel", "value": 2},

  {"log": "delete panel 2 (both windows on it): both go to panel 1"},
  {"focus": 3},
  {"key": "KEY_4"},
  {"waitMessage": "InsP: W1 panel deleted"},
  {"waitSub": 106},
  {"expectState": "insp.panelImages.1.instImage", "value": "TurbineL"},
  {"expectState": "count.panels", "value": 1},
  {"expectState": "insp.settings.window1Panel", "value": 1},
  {"expectState": "insp.settings.window2Panel", "value": 1},
  {"expectState": "insp.settings.selectedPanel", "value": 1},

  {"log": "add a panel again and give it an image: it is panel 2, selected"},
  {"key": "KEY_3"},
  {"waitSub": 106},
  {"expectState": "insp.panelImages.2.instImage", "value": "---"},
  {"expectState": "insp.settings.selectedPanel", "value": 2},
  {"set": "#10", "value": "GlassCockpitL"},
  {"expectState": "insp.panelImages.2.instImage", "value": "GlassCockpitL"},
  {"focus": 3},
  {"key": "KEY_2"},
  {"waitSub": 106},
  {"expectState": "insp.settings.window1Panel", "value": 1},
  {"expectState": "insp.settings.window2Panel", "value": 2},

  {"log": "in flight the windows show what the list says"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"waitTelem": 1},
  {"wait": 1500},
  {"expectImage": "TurbineL", "win": 1},
  {"expectImage": "GlassCockpitL", "win": 2}
 ]}
