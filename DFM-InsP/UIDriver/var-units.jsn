{"config": {"stepGap": 200},
 "steps": [
  {"log": "Lua variables from a sensor are in the pilot's default units, like gauges (0.95.1126a). Fixture insp-units over insp-aaa: spd = SMTEK Airspeed (sends kmh), vario = SMTEK Vario (sends m/s), ratio = spd / vario. Both sensor variables were saved with a stale list index (sensor 1), so they must also be found by their id and param. P1 = 0.44 gives 72 km/h (20 m/s), P2 = -0.2 gives -1 m/s"},
  {"setInput": "P1", "value": 0.44},
  {"setInput": "P2", "value": -0.2},
  {"waitForm": true},
  {"waitSub": 1},
  {"wait": 3000},
  {"expectState": "insp.settings.units.speed", "value": "m/s"},
  {"log": "default units m/s: 72 km/h reads 20 m/s"},
  {"expectState": "insp.variables.1.value", "value": 20, "tol": 0.05},
  {"expectState": "insp.variables.2.value", "value": -1, "tol": 0.01},
  {"expectState": "insp.variables.3.value", "value": -20, "tol": 0.1},

  {"log": "speed default changed to km/h: spd reads 72, vario -3.6; the ratio doesn't change"},
  {"link": "Settings >>"},
  {"waitSub": 102},
  {"link": "Units >>"},
  {"waitSub": 113},
  {"set": "Speed", "value": "km/h"},
  {"expect": "Speed", "value": "km/h"},
  {"wait": 3000},
  {"expectState": "insp.variables.1.value", "value": 72, "tol": 0.2},
  {"expectState": "insp.variables.2.value", "value": -3.6, "tol": 0.02},
  {"expectState": "insp.variables.3.value", "value": -20, "tol": 0.1},

  {"log": "and in mph: 72 km/h = 44.74 mph"},
  {"set": "Speed", "value": "mph"},
  {"wait": 3000},
  {"expectState": "insp.variables.1.value", "value": 44.74, "tol": 0.1},

  {"log": "the Lua variables menu shows each variable's own sensor (the list index is corrected from the id/param)"},
  {"restore": "Speed"},
  {"key": "KEY_ESC"},
  {"waitSub": 102},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"link": "Lua variables >>"},
  {"waitSub": 108},
  {"expectState": "insp.variables.1.SeId", "value": 137},
  {"expectState": "insp.variables.1.sensor", "notValue": 1},
  {"expectState": "insp.variables.2.sensor", "notValue": 1},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"clearInput": true}
 ]}
