{"config": {"stepGap": 200},
 "steps": [
  {"log": "Sequencer entries follow a panel's image when it changes, and go when it is cleared to ---. Fixture insp-aaa: panel 1 TurbineL, panel 2 ---, 2 stale sequencer entries (CBHarryDial <-> ChartRecorder)"},
  {"waitForm": true},
  {"waitSub": 1},
  {"link": "Panels >>"},
  {"waitSub": 106},
  {"set": "#10", "value": "GlassCockpitL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"log": "entry 1: SA up, TurbineL -> GlassCockpitL"},
  {"link": "Edit Links >>"},
  {"waitSub": 105},
  {"setInput": "SA", "value": 1},
  {"set": "#3", "value": "SA"},
  {"setInput": "SA", "value": -1},
  {"set": "#4", "value": "+"},
  {"set": "#5", "value": "TurbineL"},
  {"set": "#6", "value": "GlassCockpitL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"expectState": "seq.1.from", "value": "TurbineL"},
  {"expectState": "seq.1.to", "value": "GlassCockpitL"},
  {"expectState": "seq.2.from", "value": "ChartRecorder"},

  {"log": "panel 2's image becomes ConcentricL: entry 1 follows it, nothing removed"},
  {"link": "Panels >>"},
  {"waitSub": 106},
  {"set": "#10", "value": "ConcentricL"},
  {"waitMessage": "seq. removed", "absent": true, "for": "1s"},
  {"expectState": "insp.panelImages.2.instImage", "value": "ConcentricL"},
  {"expectState": "seq.1.from", "value": "TurbineL"},
  {"expectState": "seq.1.to", "value": "ConcentricL"},
  {"expectState": "seq.2.from", "value": "ChartRecorder"},

  {"log": "Edit Links shows the new name"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"link": "Edit Links >>"},
  {"waitSub": 105},
  {"expect": "#5", "value": "TurbineL"},
  {"expect": "#6", "value": "ConcentricL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"log": "panel 2 cleared to ---: entry 1 is removed; the fixture's entry 2 is now entry 1"},
  {"link": "Panels >>"},
  {"waitSub": 106},
  {"set": "#10", "value": "...", "noReadback": true},
  {"waitMessage": "InsP: 1 seq. removed"},
  {"waitSub": 106},
  {"expectState": "insp.panelImages.2.instImage", "value": "---"},
  {"expectState": "seq.1.from", "value": "ChartRecorder"},
  {"expectState": "count.seq", "value": 1},

  {"log": "in flight SA does nothing: window 1 stays on TurbineL"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"waitTelem": 1},
  {"wait": 1500},
  {"expectImage": "TurbineL", "win": 1},
  {"setInput": "SA", "value": 1},
  {"wait": 1500},
  {"waitMessage": "InsP W1:", "absent": true, "for": "1s", "anyTime": true},
  {"expectImage": "TurbineL", "win": 1}
 ]}
