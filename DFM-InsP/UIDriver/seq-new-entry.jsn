{"config": {"stepGap": 200, "stopOnFail": false},
 "steps": [
  {"log": "A new sequencer entry keeps its default To (review finding 5). Edit Links F1 adds an entry with From '*' and To '*'; the screen shows To as '+' (next panel), but in flight only '+' means next: '*' is looked up as a panel name, not found, and window 1 is set to panel 0 and goes blank. Fixture insp-aaa: panel 1 TurbineL. FAILS until a new entry starts with To '+'"},
  {"waitForm": true},
  {"waitSub": 1},
  {"link": "Edit Links >>"},
  {"waitSub": 105},
  {"log": "the fixture has 2 entries; F1 adds entry 3: #13 switch, #14 trigger, #15 From, #16 To"},
  {"key": "KEY_1"},
  {"waitSub": 105},
  {"expect": "#15", "value": "*"},
  {"expect": "#16", "value": "+"},
  {"log": "assign SB, held at its active position, and leave From, To and the trigger (+) as they are"},
  {"setInput": "SB", "value": 1},
  {"set": "#13", "value": "SB"},
  {"waitMessage": "do not move switch", "absent": true, "for": "1s"},
  {"setInput": "SB", "value": -1},
  {"expect": "#14", "value": "+"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "in flight: window 1 on TurbineL, then SB up"},
  {"waitTelem": 1},
  {"wait": 1500},
  {"expectImage": "TurbineL", "win": 1},
  {"setInput": "SB", "value": 1},
  {"wait": 1500},
  {"waitMessage": "switching to: *", "absent": true, "for": "1s", "anyTime": true},
  {"expectImage": ".png", "win": 1}
 ]}
