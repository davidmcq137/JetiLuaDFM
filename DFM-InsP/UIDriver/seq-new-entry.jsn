{"config": {"stepGap": 200, "stopOnFail": false},
 "steps": [
  {"log": "A new sequencer entry's default To (review finding 5). Edit Links F1 adds an entry; the screen shows To as '+' (next panel). Before 0.95 it was stored as '*', which in flight was looked up as a panel name, not found, and window 1 went blank. Now it is '+': SB moves window 1 to the next panel with an image. In fixture insp-aaa panel 2 is '---' (no image), which '+' skips since 0.95.1122b, so window 1 comes back round to TurbineL. Also checks the startup warning: the fixture's two old entries name CBHarryDial and ChartRecorder, which are not panels"},
  {"waitMessage": "InsP: seq. see console", "anyTime": true},
  {"waitForm": true},
  {"waitSub": 1},
  {"link": "Edit Links >>"},
  {"waitSub": 105},
  {"log": "the fixture has 2 entries; F1 adds entry 3: #13 switch, #14 trigger, #15 From, #16 To"},
  {"key": "KEY_1"},
  {"waitSub": 105},
  {"expect": "#15", "value": "*"},
  {"expect": "#16", "value": "+"},
  {"log": "assign SB, held at its active position, and leave From, To and the trigger (+) as they are"},
  {"setInput": "SB", "value": 1},
  {"set": "#13", "value": "SB"},
  {"waitMessage": "InsP: hold switch on", "absent": true, "for": "1s"},
  {"setInput": "SB", "value": -1},
  {"expect": "#14", "value": "+"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "in flight: window 1 on TurbineL, then SB up"},
  {"waitTelem": 1},
  {"wait": 1500},
  {"expectImage": "TurbineL", "win": 1},
  {"setInput": "SB", "value": 1},
  {"wait": 1500},
  {"waitMessage": "InsP W1: *", "absent": true, "for": "1s", "anyTime": true},
  {"waitMessage": "InsP W1: TurbineL", "anyTime": true},
  {"expectImage": "TurbineL", "win": 1}
 ]}
