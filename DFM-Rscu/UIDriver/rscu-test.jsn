{"steps": [
  {"log": "DFM-Rscu test: inputboxes, mixer calibration, rescue on/off. Needs SensorE (config Apps/DFM-Rscu/Json) with DFM-Rscu's lat/lon sensors set. Open DFM-Rscu from the Applications menu"},
  {"waitForm": true},
  {"waitSub": 1},
  {"wait": 3000},
  {"expectState": "rscu.configOK", "value": true},
  {"log": "home is set after 50 GPS reads; the next step FAILs if it isn't set yet"},
  {"expectState": "rscu.zeroLat"},
  {"remember": "rscu.zeroLat", "as": "zl"},
  {"remember": "rscu.zeroLon", "as": "zo"},
  {"log": "hold the model at home while the form is up: with no DFM-Rscu window showing, each new GPS point is buffered (max 100)"},
  {"sensorPause": true},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo"}},
  {"expectState": "rscu.circleMax"},

  {"log": "switches off before assigning them, so nothing fires"},
  {"setInput": "SA", "value": -1},
  {"setInput": "SB", "value": -1},
  {"setInput": "P2", "value": 0},

  {"link": "App Settings"},
  {"waitSub": 10},
  {"set": "Rescue mode switch", "value": "SA"},
  {"expect": "Rescue mode switch", "value": "SA"},
  {"set": "Mixer calibration switch", "value": "SB"},
  {"expect": "Mixer calibration switch", "value": "SB"},

  {"log": "Elevator control must be plain P: SA, PC and PI are rejected"},
  {"set": "Elevator control", "value": {"switch": "SA", "mode": "S", "activeOn": 1}},
  {"waitMessage": "must be proportional"},
  {"waitSub": 1},
  {"link": "App Settings"},
  {"waitSub": 10},
  {"set": "Elevator control", "value": {"switch": "P2", "mode": "PC"}},
  {"waitMessage": "must be P, not PC"},
  {"waitSub": 1},
  {"link": "App Settings"},
  {"waitSub": 10},
  {"set": "Elevator control", "value": {"switch": "P2", "mode": "PI"}},
  {"waitMessage": "must be P, not PI"},
  {"waitSub": 1},
  {"link": "App Settings"},
  {"waitSub": 10},
  {"set": "Elevator control", "value": "P2"},
  {"expect": "Elevator control", "value": {"switch": "P2", "mode": "P"}},

  {"log": "mixer calibration: elevator stick at 40%, calibration switch on then off"},
  {"setInput": "P2", "value": 0.4},
  {"setInput": "SB", "value": 1},
  {"waitMessage": "Mixer calibration active"},
  {"waitAudio": "mixercalactive"},
  {"expectState": "rscu.calibrating", "value": true},
  {"setInput": "SB", "value": -1},
  {"waitMessage": "Mixer calibration captured"},
  {"waitAudio": "mixercaldone"},
  {"waitNumber": -40},
  {"expectState": "rscu.maxElevGain", "value": -40},
  {"expectState": "rscu.calibrating", "value": false},
  {"link": "<<<Back to main menu"},
  {"waitSub": 1},
  {"link": "App Settings"},
  {"waitSub": 10},
  {"expect": "Elevator mix percentage", "value": -40},
  {"clearInput": "P2"},

  {"log": "rescue mode: 10 m from home is too close"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 10}},
  {"wait": 1500},
  {"expectState": "rscu.dist", "value": 10, "tol": 1},
  {"setInput": "SA", "value": 1},
  {"waitAudio": "rthnotenabled"},
  {"waitBeep": true},
  {"expectState": "rscu.rescueOn", "value": -1},
  {"setInput": "SA", "value": -1},
  {"waitAudio": "rescuemodeoff"},

  {"log": "1000 m out (beyond circleMax): rescue turns on, then off"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 1000}},
  {"wait": 1500},
  {"expectState": "rscu.dist", "value": 1000, "tol": 2},
  {"setInput": "SA", "value": 1},
  {"waitAudio": "rthenabled"},
  {"expectState": "rscu.rescueOn", "value": 1},
  {"setInput": "SA", "value": -1},
  {"waitAudio": "rescuemodeoff"},
  {"expectState": "rscu.rescueOn", "value": -1},
  {"clearInput": true},

  {"log": "put your settings back (Elevator control last: if it was unassigned, DFM-Rscu shows its message)"},
  {"restore": "Elevator mix percentage"},
  {"restore": "Rescue mode switch"},
  {"restore": "Mixer calibration switch"},
  {"restore": "Elevator control"},

  {"log": "close the form and show the DFM-Rscu Status telemetry window before SensorE flies again: with no DFM-Rscu window up, flight path points are buffered (max 100) and then dropped"},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"waitTelem": 2},
  {"sensorPosition": false},
  {"sensorPause": false},
  {"log": "DFM-Rscu test finished"}
]}
