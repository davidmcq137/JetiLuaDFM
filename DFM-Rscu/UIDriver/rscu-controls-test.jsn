{"config": {"stepGap": 200},
 "steps": [
  {"log": "DFM-Rscu steering and elevator outputs (setControl) during a rescue. Needs SensorE (config Apps/DFM-Rscu/SensorE). The model is held at set positions north/east of home; DFM-Rscu has no heading sensor here, so its heading comes from the last move of more than 3 m. Positive steering = turn right. Open DFM-Rscu from the Applications menu and leave it open"},
  {"waitForm": true},
  {"waitSub": 1},
  {"wait": 3000},
  {"expectState": "rscu.configOK", "value": true},
  {"log": "home is set after 50 GPS reads; the next step FAILs if it isn't set yet"},
  {"expectState": "rscu.zeroLat"},
  {"remember": "rscu.zeroLat", "as": "zl"},
  {"remember": "rscu.zeroLon", "as": "zo"},
  {"sensorPause": true},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo"}},

  {"log": "settings not in the menu: the timings below assume these defaults"},
  {"expectState": "rscu.rescueOnDelay", "value": 3},
  {"expectState": "rscu.holdTurn", "value": 4},
  {"expectState": "rscu.circStrat", "value": 2},
  {"expectState": "rscu.circleMax"},

  {"log": "setup: rescue SA, calibration SB, elevator P2; calibrate the elevator mix to -40%"},
  {"setInput": "SA", "value": -1},
  {"setInput": "SB", "value": -1},
  {"setInput": "P2", "value": 0},
  {"link": "App Settings"},
  {"waitSub": 10},
  {"set": "Rescue mode switch", "value": "SA"},
  {"set": "Mixer calibration switch", "value": "SB"},
  {"set": "Elevator control", "value": "P2"},
  {"setInput": "P2", "value": 0.4},
  {"setInput": "SB", "value": 1},
  {"waitMessage": "Rscu: mixer cal active"},
  {"setInput": "SB", "value": -1},
  {"waitMessage": "Rscu: mixer cal captured"},
  {"expectState": "rscu.maxElevGain", "value": -40},
  {"clearInput": "P2"},
  {"link": "<<<Back to main menu"},
  {"waitSub": 1},
  {"link": "Rescue Settings"},
  {"waitSub": 11},
  {"set": "Preferred turn", "value": "right"},
  {"expect": "Preferred turn", "value": "right"},
  {"log": "these outputs are the Amix/Emix curves: steering law Curves (the bank-angle law is tested in rscu-assist-leg)"},
  {"set": "Steering", "value": "Curves"},
  {"expect": "Steering", "value": "Curves"},

  {"log": "rescue off: both outputs 0"},
  {"wait": 500},
  {"expectControl": "Rscu Steering", "value": 0},
  {"expectControl": "Rscu Elevator", "value": 0},

  {"log": "1000 m north, flying east (home is behind on the right)"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 1000}},
  {"wait": 1500},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 1000, "east": 100}},
  {"wait": 1500},
  {"expectState": "rscu.heading", "value": 90, "tol": 1},

  {"log": "rescue on: outputs stay 0 for the 3 s Rescue On Delay, then a hard right turn with up elevator (gain -40% x elevator mix -100% = +0.4)"},
  {"setInput": "SA", "value": 1},
  {"waitAudio": "rthenabled"},
  {"wait": 1000},
  {"expectControl": "Rscu Steering", "value": 0},
  {"expectControl": "Rscu Elevator", "value": 0},
  {"waitControl": "Rscu Steering", "value": 1, "timeout": "4s"},
  {"expectState": "rscu.steer", "min": 90, "max": 100},
  {"expectState": "rscu.maxElevGain", "value": -40},
  {"expectState": "rscu.elevCalc", "value": 0.4, "tol": 0.01},
  {"expectState": "rscu.validElev", "value": true},
  {"expectControl": "Rscu Elevator", "value": 0.4},

  {"log": "flying west instead: hard left"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 1000}},
  {"wait": 1500},
  {"expectState": "rscu.heading", "value": 270, "tol": 1},
  {"expectControl": "Rscu Steering", "value": -1},
  {"expectControl": "Rscu Elevator", "value": 0.4},

  {"log": "flying straight at home: no steering, no elevator"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 900}},
  {"wait": 1500},
  {"expectState": "rscu.heading", "value": 180, "tol": 1},
  {"expectControl": "Rscu Steering", "value": 0},
  {"expectControl": "Rscu Elevator", "value": 0},

  {"log": "4.5 deg off to the left of home: a small right correction (mix slope 1 near centre), elevator still 0 (inside its +-5% dead band)"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 800, "east": 7}},
  {"wait": 1500},
  {"expectState": "rscu.steer", "min": 3.5, "max": 5.5},
  {"expectControl": "Rscu Steering", "min": 0.015, "max": 0.035},
  {"expectControl": "Rscu Elevator", "value": 0},

  {"log": "inside the circle: turning outbound. Geometry says hard left, but the preferred turn (right) is held for 4 s"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 50}},
  {"waitAudio": "turningoutbound", "timeout": "3s"},
  {"expectState": "rscu.outbound", "value": true},
  {"expectControl": "Rscu Steering", "value": 1},
  {"expectState": "rscu.steer", "value": 180},
  {"waitControl": "Rscu Steering", "value": -1, "timeout": "6s"},
  {"expectControl": "Rscu Elevator", "value": 0.4},

  {"log": "back out past the outer circle: turning inbound, right turn held for 4 s even when flying west makes the geometry say left"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 1000}},
  {"waitAudio": "turninginbound", "timeout": "3s"},
  {"expectControl": "Rscu Steering", "value": 1},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 1000, "east": -100}},
  {"wait": 1000},
  {"expectControl": "Rscu Steering", "value": 1},
  {"expectState": "rscu.heading", "value": 270, "tol": 1},
  {"expectState": "rscu.outbound", "value": false},
  {"waitControl": "Rscu Steering", "value": -1, "timeout": "5s"},

  {"log": "rescue off: both outputs back to 0"},
  {"setInput": "SA", "value": -1},
  {"waitAudio": "rescuemodeoff"},
  {"wait": 500},
  {"expectControl": "Rscu Steering", "value": 0},
  {"expectControl": "Rscu Elevator", "value": 0},
  {"clearInput": true},

  {"log": "put your settings back (Elevator control last: if it was unassigned, DFM-Rscu shows its message)"},
  {"restore": "Preferred turn"},
  {"restore": "Steering"},
  {"link": "<<<Back to main menu"},
  {"waitSub": 1},
  {"link": "App Settings"},
  {"waitSub": 10},
  {"restore": "Elevator mix percentage"},
  {"restore": "Rescue mode switch"},
  {"restore": "Mixer calibration switch"},
  {"restore": "Elevator control"},

  {"log": "close the form and show the DFM-Rscu Status telemetry window before SensorE flies again: with no DFM-Rscu window up, flight path points are buffered (max 100) and then dropped"},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"waitTelem": 2},
  {"sensorPosition": false},
  {"sensorPause": false},
  {"log": "DFM-Rscu controls test finished"}
]}
