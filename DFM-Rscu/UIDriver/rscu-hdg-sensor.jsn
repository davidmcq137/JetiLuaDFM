{"steps": [
  {"log": "DFM-Rscu heading sensor (0.6.1125a). SensorE config DFM-Rscu/hdg (fixture rscu-hdg) adds MGPS 'Heading' = the simulator's true course, (heading + trueDir) % 360 (trueDir 78.88 here); on the emulator Rscu picks it by its label. While SensorE is paused the model doesn't move, so the heading computed from GPS points can't change: if Rscu's heading follows a value set in the simulator, it came from the sensor"},
  {"waitForm": true},
  {"waitSub": 1},
  {"wait": 3000},
  {"expectState": "rscu.zeroLat"},
  {"remember": "rscu.zeroLat", "as": "zl"},
  {"remember": "rscu.zeroLon", "as": "zo"},

  {"log": "the Telemetry Sensors menu shows the heading sensor"},
  {"link": "Telemetry Sensors"},
  {"waitSub": 12},
  {"expect": "Heading Sensor", "value": "MGPS_Heading [deg]"},
  {"link": "<<<Back to main menu"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "freeze the simulator, then set its heading: Rscu's heading must follow the sensor, i.e. the simulator heading + trueDir (78.88)"},
  {"sensorPause": true},
  {"wait": 1000},
  {"sensorVars": {"heading": 237}},
  {"wait": 1000},
  {"expectState": "sensorE.heading", "value": 237},
  {"expectState": "rscu.heading", "value": 315.88, "tol": 1},
  {"log": "past 360 the sensor wraps: 412 + 78.88 -> 130.88"},
  {"sensorVars": {"heading": 412}},
  {"wait": 1000},
  {"expectState": "rscu.heading", "value": 130.88, "tol": 1},

  {"log": "un-assign the heading sensor ('...'): a new simulator heading must no longer be seen. (Opening Telemetry Sensors calls getSensors, which reloads SensorE's config and moves the frozen model back to x=0 y=0, so the computed heading jumps once; it can't become 150 though)"},
  {"openForm": "DFM-Rscu"},
  {"waitForm": true},
  {"waitSub": 1},
  {"link": "Telemetry Sensors"},
  {"waitSub": 12},
  {"set": "Heading Sensor", "value": "..."},
  {"expect": "Heading Sensor", "value": "..."},
  {"link": "<<<Back to main menu"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"log": "hold the GPS output at one spot (a sensorVars change makes the paused simulator take one step, so pausing alone isn't enough)"},
  {"sensorPosition": {"lat": "$zl", "lon": "$zo", "north": 200}},
  {"wait": 1500},
  {"remember": "rscu.heading", "as": "hc"},
  {"sensorVars": {"heading": 150}},
  {"wait": 1500},
  {"log": "the position hasn't moved, so the computed heading must not have either, though the sensor now says 228.88"},
  {"expectState": "rscu.heading", "value": "$hc"},

  {"log": "unfreeze: the model flies again and the computed heading takes over (from GPS points 3 m apart)"},
  {"sensorPosition": false},
  {"sensorPause": false},
  {"wait": 8000},
  {"expectState": "rscu.heading", "notValue": "$hc"}
 ]}
