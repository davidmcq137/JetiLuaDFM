{"steps": [
  {"log": "DFM-Rscu heading sensor (0.6.1125a). SensorE config DFM-Rscu/hdg (fixture rscu-hdg) adds MGPS 'Heading' = the simulator's course (heading % 360); on the emulator Rscu picks it by its label. While SensorE is paused the model doesn't move, so the heading computed from GPS points can't change: if Rscu's heading follows a value set in the simulator, it came from the sensor"},
  {"waitForm": true},
  {"waitSub": 1},
  {"wait": 3000},
  {"expectState": "rscu.zeroLat"},

  {"log": "the Telemetry Sensors menu shows the heading sensor"},
  {"link": "Telemetry Sensors"},
  {"waitSub": 12},
  {"expect": "Heading Sensor", "value": "MGPS_Heading [deg]"},
  {"link": "<<<Back to main menu"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "freeze the simulator, then set its heading: Rscu's heading must follow"},
  {"sensorPause": true},
  {"wait": 1000},
  {"sensorVars": {"heading": 237}},
  {"wait": 1000},
  {"expectState": "sensorE.heading", "value": 237},
  {"expectState": "rscu.heading", "value": 237, "tol": 0.5},
  {"log": "past 360 the sensor wraps: 412 -> 52"},
  {"sensorVars": {"heading": 412}},
  {"wait": 1000},
  {"expectState": "rscu.heading", "value": 52, "tol": 0.5},

  {"log": "un-assign the heading sensor ('...'): a new simulator heading must no longer be seen. (Opening Telemetry Sensors calls getSensors, which reloads SensorE's config and moves the frozen model back to x=0 y=0, so the computed heading jumps once; it can't become 150 though)"},
  {"openForm": "DFM-Rscu"},
  {"waitForm": true},
  {"waitSub": 1},
  {"link": "Telemetry Sensors"},
  {"waitSub": 12},
  {"set": "Heading Sensor", "value": "..."},
  {"expect": "Heading Sensor", "value": "..."},
  {"link": "<<<Back to main menu"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"sensorVars": {"heading": 150}},
  {"wait": 1500},
  {"expectState": "rscu.heading", "notValue": 150},
  {"remember": "rscu.heading", "as": "hc"},

  {"log": "unfreeze: the model flies again and the computed heading takes over (from GPS points 3 m apart)"},
  {"sensorPause": false},
  {"wait": 8000},
  {"expectState": "rscu.heading", "notValue": "$hc"}
 ]}
