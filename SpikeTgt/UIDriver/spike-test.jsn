{"steps": [
  {"log": "self-test against SpikeTgt: open SpikeTgt from the Applications menu"},
  {"waitForm": true},
  {"waitSub": 1},
  {"expectState": "tgt"},
  {"set": "Spike Int", "value": 42},
  {"expect": "Spike Int", "value": 42},
  {"expectState": "tgt.intVal", "value": 42},
  {"set": "Spike Int", "value": 150},
  {"expect": "Spike Int", "value": 100},
  {"expectState": "tgt.intVal", "min": 0, "max": 100},
  {"set": "Spike Sel", "value": "C"},
  {"expect": "Spike Sel", "value": "C"},
  {"expectState": "tgt.selIdx", "value": 3},
  {"set": "Spike Chk", "value": true},
  {"expect": "Spike Chk", "value": true},
  {"expectState": "tgt.chk", "value": true},
  {"set": "Spike Chk", "value": true},
  {"key": "KEY_1"},
  {"expectState": "tgt.lastKey", "value": "1"},
  {"answer": true},
  {"link": "Sub 2 >>"},
  {"waitEvent": "sub", "value": 2},
  {"waitSub": 2},
  {"set": "Spike Int2", "value": -7},
  {"expect": "Spike Int2", "value": -7},
  {"expectState": "tgt.int2", "value": -7},
  {"link": "<< Back"},
  {"waitEvent": "sub", "value": 1},
  {"waitSub": 1},
  {"expect": "Spike Int", "value": 100},
  {"expect": "Spike Chk", "value": true},
  {"confirm": "Does the white box say int=100 sel=3 chk=true int2=-7?"},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"log": "now show the SpikeTgt telemetry window on the main screen"},
  {"telemKey": "KEY_2", "win": 1, "timeout": "1m"},
  {"expectState": "tgt.telemKey", "value": "2"},
  {"log": "self-test finished"}
]}
