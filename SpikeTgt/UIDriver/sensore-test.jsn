{"steps": [
  {"log": "SensorE API self-test; needs SensorE and SpikeTgt running, no form"},
  {"wait": 1500},
  {"expectState": "sensorE.configDir", "value": "Apps/DFM-Maps/SensorE"},
  {"expectState": "sensorE.gps", "value": true},
  {"sensorPause": true},
  {"remember": "sensorE.t", "as": "t0"},
  {"remember": "sensorE.x", "as": "x0"},
  {"wait": 1000},
  {"expectState": "sensorE.t", "value": "$t0"},
  {"expectState": "sensorE.x", "value": "$x0"},
  {"sensorStep": 5},
  {"expectState": "sensorE.t", "notValue": "$t0"},
  {"expectState": "sensorE.stepsPending", "value": 0},
  {"sensorTime": 10},
  {"wait": 500},
  {"expectState": "sensorE.t", "value": 10},
  {"remember": "sensorE.x", "as": "x10"},
  {"sensorTime": 20},
  {"wait": 500},
  {"expectState": "sensorE.x", "notValue": "$x10"},
  {"sensorPosition": [100, -50]},
  {"wait": 500},
  {"expectState": "sensorE.x", "value": 100},
  {"expectState": "sensorE.y", "value": -50},
  {"expectState": "sensorE.held", "value": true},
  {"sensorPosition": false},
  {"wait": 500},
  {"expectState": "sensorE.held", "value": false},
  {"log": "lat/lon positions: SensorE's DFM-Maps origin is 41.340050, -74.430933, trueDir 76"},
  {"sensorPosition": {"lat": "41.340050", "lon": "-74.430933"}},
  {"wait": 500},
  {"expectState": "sensorE.x", "value": 0, "tol": 0.05},
  {"expectState": "sensorE.y", "value": 0, "tol": 0.05},
  {"log": "10 m north of the origin is x -9.703, y 2.419 in SensorE's frame (rotated by trueDir)"},
  {"sensorPosition": {"lat": "41.340050", "lon": "-74.430933", "north": 10}},
  {"wait": 500},
  {"expectState": "sensorE.x", "value": -9.703, "tol": 0.05},
  {"expectState": "sensorE.y", "value": 2.419, "tol": 0.05},
  {"sensorPosition": {"lat": "41.340050", "lon": "-74.430933", "north": 0.5}},
  {"wait": 500},
  {"expectState": "sensorE.x", "value": -0.485, "tol": 0.02},
  {"log": "round trip: x, y -> lat/lon strings -> back to x, y"},
  {"sensorPosition": [30, 40]},
  {"wait": 500},
  {"remember": "sensorE.latStr", "as": "la"},
  {"remember": "sensorE.lonStr", "as": "lo"},
  {"sensorPosition": false},
  {"sensorPosition": {"lat": "$la", "lon": "$lo"}},
  {"wait": 500},
  {"expectState": "sensorE.x", "value": 30, "tol": 0.2},
  {"expectState": "sensorE.y", "value": 40, "tol": 0.2},
  {"expectState": "sensorE.held", "value": true},
  {"sensorPosition": false},
  {"sensorVars": {"xp": 5, "yp": 6, "heading": 90, "zp": 100, "pitch": -2}},
  {"expectState": "sensorE.heading", "value": 90},
  {"expectState": "sensorE.pitch", "value": -2},
  {"sensorField": 1},
  {"expectState": "sensorE.field"},
  {"sensorPause": false},
  {"waitSensorTime": 21},
  {"log": "the next step should FAIL: bogus is not a simulator variable"},
  {"sensorVars": {"bogus": 1}}
]}
