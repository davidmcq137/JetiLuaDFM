{"steps": [
  {"log": "inputs/sensors/controls self-test; needs no form. SensorE should use Apps/DFM-Maps/JSON (Altitude = P5(0,200))"},
  {"wait": 1500},
  {"remember": "tgt.sensLabel", "as": "sens"},
  {"setInput": "P6", "value": 0.5},
  {"expectState": "tgt.p6", "value": 0.5},
  {"expectControl": "SpikeCtl", "value": 0.5},
  {"setInput": "SA", "value": 1},
  {"expectState": "tgt.sa", "value": 1},
  {"log": "the next step needs system.createSwitch (firmware 5.01)"},
  {"expectState": "tgt.saVal", "value": 1},
  {"log": "SensorE's slider: P5 = 1 should give Altitude 200 through SensorE"},
  {"setInput": "P5", "value": 1},
  {"expectState": "tgt.sensVal", "value": 200},
  {"setInput": "P5", "value": -1, "for": "target"},
  {"expectState": "tgt.sensVal", "notValue": 0},
  {"clearInput": "P5"},
  {"setSensor": "$sens", "value": 123},
  {"expectState": "tgt.sensVal", "value": 123},
  {"setSensor": "$sens", "valid": false},
  {"expectState": "tgt.sensValid", "value": false},
  {"clearSensor": "$sens"},
  {"expectState": "tgt.sensValid", "value": true},
  {"expectState": "tgt.sensVal", "notValue": 123},
  {"expectState": "tgt.posNil", "value": false},
  {"setSensor": "Latitude", "valid": false},
  {"expectState": "tgt.posNil", "value": true},
  {"clearSensor": true},
  {"expectState": "tgt.posNil", "value": false},
  {"setInput": "P6", "value": -0.25, "for": "target"},
  {"waitControl": "SpikeCtl", "value": -0.25},
  {"clearInput": true},
  {"log": "the next step should FAIL: there is no such sensor, and the log lists the labels"},
  {"setSensor": "No Such Sensor", "value": 1}
]}
