{"steps": [
  {"log": "DFM-Path steering and elevator outputs (setControl) on the saved path (Json/Path.jsn, 7 points; point 1 at 100 m). Needs SensorE with its own config (Apps/DFM-Path/SensorE, a copy of DFM-Rscu's; altitude from zpAlt, which the script overrides). The model is held at set positions south of point 1; the heading comes from the last move of more than 3 m. Positive steering = turn right. Open DFM-Path from the Applications menu and leave it open"},
  {"waitForm": true},
  {"waitSub": 1},
  {"wait": 2000},
  {"sensorPause": true},
  {"sensorPosition": {"lat": "41.34061691", "lon": "-74.42942578", "north": -300}},

  {"log": "setup: path mode switch SG (off), sensors, elevator mix -40%, pGain 0.100"},
  {"setInput": "SG", "value": -1},
  {"set": "Path mode switch", "value": "SG"},
  {"set": "GPS Lat Sensor", "value": "MGPS_Latitude []"},
  {"set": "GPS Lng Sensor", "value": "MGPS_Longitude []"},
  {"set": "Altitude Sensor", "value": "CBOX200_zpAlt [m]"},
  {"set": "Roll Sensor", "value": "CBOX200_Roll [deg]"},
  {"set": "Pitch Sensor", "value": "CBOX200_Pitch [deg]"},
  {"set": "Elevator mix percentage", "value": -40},
  {"set": "Alt Loop pGain", "value": 100},
  {"expectState": "path.pGain", "value": 0.1, "tol": 0.0001},

  {"log": "load the saved path (Save Path is never pressed)"},
  {"link": "Load saved Path >>"},
  {"waitMessage": "Path file read, 7 points"},
  {"expectState": "path.nPoints", "value": 7},

  {"log": "200 m south of point 1, flying north straight at it, at its 100 m"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 100},
  {"sensorPosition": {"lat": "41.34061691", "lon": "-74.42942578", "north": -200}},
  {"wait": 1500},
  {"expectState": "path.hasPos", "value": true},
  {"expectState": "path.heading", "value": 0, "tol": 1},
  {"expectState": "path.altitude", "value": 100},

  {"log": "path mode off: both outputs 0"},
  {"expectControl": "Path Steering", "value": 0},
  {"expectControl": "Path Elevator", "value": 0},

  {"log": "SG on: steering to point 1, altitude setpoint 100 m; on course and on altitude, so both outputs 0"},
  {"setInput": "SG", "value": 1},
  {"waitAudio": "steeringtopoint"},
  {"expectState": "path.flyIndex", "value": 1},
  {"expectState": "path.altSet", "value": 100},
  {"wait": 500},
  {"expectControl": "Path Steering", "value": 0},
  {"expectControl": "Path Elevator", "value": 0},

  {"log": "altitude loop: elevator = (altitude - setpoint) x pGain, limited to +-1"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 105},
  {"waitControl": "Path Elevator", "value": 0.5, "timeout": "2s"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 95},
  {"waitControl": "Path Elevator", "value": -0.5, "timeout": "2s"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 150},
  {"waitControl": "Path Elevator", "value": 1, "timeout": "2s"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 50},
  {"waitControl": "Path Elevator", "value": -1, "timeout": "2s"},

  {"log": "pGain -0.100 flips the correction and nothing else"},
  {"set": "Alt Loop pGain", "value": -100},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 105},
  {"waitControl": "Path Elevator", "value": -0.5, "timeout": "2s"},
  {"expectControl": "Path Steering", "value": 0},
  {"set": "Alt Loop pGain", "value": 100},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 100},
  {"waitControl": "Path Elevator", "value": 0, "timeout": "2s"},

  {"log": "flying east, point 1 to the north-west: hard left, turn elevator +0.4 (-40% x mix -100%)"},
  {"sensorPosition": {"lat": "41.34061691", "lon": "-74.42942578", "north": -200, "east": 100}},
  {"wait": 1500},
  {"expectState": "path.heading", "value": 90, "tol": 1},
  {"expectState": "path.steer", "min": -120, "max": -113},
  {"expectControl": "Path Steering", "value": -1},
  {"expectControl": "Path Elevator", "value": 0.4},

  {"log": "flying west, point 1 to the north: hard right, turn elevator +0.4"},
  {"sensorPosition": {"lat": "41.34061691", "lon": "-74.42942578", "north": -200}},
  {"wait": 1500},
  {"expectState": "path.heading", "value": 270, "tol": 1},
  {"expectState": "path.steer", "value": 90, "tol": 1},
  {"expectControl": "Path Steering", "value": 1},
  {"expectControl": "Path Elevator", "value": 0.4},

  {"log": "in a turn the turn elevator adds to the altitude correction: 5 m high gives 0.5 + 0.4 = 0.9; 50 m high would be 1 + 0.4 = 1.4, but setControl takes -1..1, so it is limited to 1"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 105},
  {"waitControl": "Path Elevator", "value": 0.9, "timeout": "2s"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 150},
  {"waitControl": "Path Elevator", "value": 1, "timeout": "2s"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 50},
  {"log": "50 m low in the turn: -1 + 0.4 = -0.6 (inside the limit)"},
  {"waitControl": "Path Elevator", "value": -0.6, "timeout": "2s"},
  {"setSensor": "zpAlt", "sensorName": "CBOX200", "value": 100},

  {"log": "back on course, flying north at point 1: both 0"},
  {"sensorPosition": {"lat": "41.34061691", "lon": "-74.42942578", "north": -100}},
  {"wait": 1500},
  {"expectState": "path.heading", "value": 0, "tol": 1},
  {"expectControl": "Path Steering", "value": 0},
  {"expectControl": "Path Elevator", "value": 0},

  {"log": "within 20 m of point 1: on to point 2, whose altitude is 50 m"},
  {"sensorPosition": {"lat": "41.34061691", "lon": "-74.42942578", "north": -10}},
  {"waitMessage": "Steering to point 2", "timeout": "3s"},
  {"expectState": "path.flyIndex", "value": 2},
  {"expectState": "path.altSet", "value": 50},

  {"log": "manual altitude: a 0-100% control (P5 as PC) at 60% sets 60 m, over the path's 50 m. setInput is the raw position: PC maps -1..1 to 0..100%, so 60% is +0.2"},
  {"set": "Man alt setpoint (0-100m)", "value": {"switch": "P5", "mode": "PC"}},
  {"setInput": "P5", "value": 0.2, "for": "target"},
  {"wait": 1000},
  {"expectState": "path.altSet", "value": 60, "tol": 0.5},
  {"clearInput": "P5"},

  {"log": "SG off: both outputs back to 0"},
  {"setInput": "SG", "value": -1},
  {"wait": 500},
  {"expectState": "path.flyIndex", "value": 0},
  {"expectControl": "Path Steering", "value": 0},
  {"expectControl": "Path Elevator", "value": 0},
  {"clearSensor": true},
  {"clearInput": true},

  {"log": "put your settings back (Man alt setpoint last: unassigning it shows DFM-Path's message)"},
  {"restore": "Alt Loop pGain"},
  {"restore": "Elevator mix percentage"},
  {"restore": "Path mode switch"},
  {"restore": "GPS Lat Sensor"},
  {"restore": "GPS Lng Sensor"},
  {"restore": "Altitude Sensor"},
  {"restore": "Roll Sensor"},
  {"restore": "Pitch Sensor"},
  {"restore": "Man alt setpoint (0-100m)"},
  {"sensorPosition": false},
  {"sensorPause": false},
  {"log": "DFM-Path controls test finished"}
]}
