{"config": {"stepGap": 200, "stopOnFail": false},
 "steps": [
  {"log": "A whole Batt day: set up a group of two 500 mAh packs (warnings at 50% and 20%), choose the mAh sensor and the model's group, then fly: the RX appears (SA = 1 on the emulator), the battery choice opens, Enter picks pack 1, the throttle (P1) drains it through SensorE's IBP 2S LiFe, both warnings play, and a restart keeps the cycle count"},
  {"waitForm": true},
  {"waitSub": 1},

  {"log": "Battery Group Setup: add a group, edit it, add two packs"},
  {"link": "Battery Group Setup>>"},
  {"waitSub": 4},
  {"key": "KEY_2"},
  {"waitSub": 4},
  {"focus": 1},
  {"key": "KEY_3"},
  {"waitSub": 7},
  {"key": "KEY_2"},
  {"waitSub": 7},
  {"key": "KEY_2"},
  {"waitSub": 7},
  {"log": "rows: header, then per pack: label, Cap, W1, W2, Cyc (#7-#10 pack 1, #13-#16 pack 2)"},
  {"set": "#7", "value": 500},
  {"set": "#8", "value": 50},
  {"set": "#9", "value": 20},
  {"set": "#13", "value": 500},
  {"set": "#14", "value": 50},
  {"set": "#15", "value": 20},
  {"key": "KEY_ESC"},
  {"waitSub": 4},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"link": "Settings>>"},
  {"waitSub": 3},
  {"set": "Battery mAh sensor", "value": "IBP 2S LiFe-> Capacity"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},

  {"link": "Model Battery Group>>"},
  {"waitSub": 2},
  {"set": "#1", "value": "Group 1"},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "the RX appears: the battery choice opens by itself (parent 0)"},
  {"setInput": "P1", "value": -1},
  {"setInput": "SA", "value": 1},
  {"waitForm": true, "timeout": "5s"},
  {"focus": 1},
  {"key": "KEY_ENTER"},
  {"waitAudio": "selected_battery"},
  {"waitNumber": 1},
  {"waitClosed": true},
  {"waitTelem": 1},

  {"log": "throttle up: the pack drains in a few seconds (SensorE's IBP runs 100x fast)"},
  {"setInput": "P1", "value": 1},
  {"waitAudio": "Lang/en/Low_Battery", "timeout": "30s"},
  {"waitAudio": "Lang/en/low_battery_land_now", "timeout": "30s"},
  {"setInput": "P1", "value": -1},
  {"wait": 2000},

  {"log": "restart: destroy saves; pack 1 has 1 cycle, the model remembers pack 1"},
  {"restartApp": "DFM-Batt"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "contains": "\"lastBattery\":1"},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "contains": "\"lastGroup\":1"},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "contains": "\"cyc\":1"},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "contains": "\"Group 1\""}
 ]}
