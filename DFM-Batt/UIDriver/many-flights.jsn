{"config": {"stepGap": 200, "stopOnFail": false},
 "steps": [
  {"log": "Three flights in a day on one model (fixture batt-26: group Field, pack 1 has 40 cycles, pack 2 has 7; group Glider, 9). The TX is switched off and on between flights (restartApp). Each choice adds exactly one cycle to each chosen pack, the warnings sound on every flight, and nothing else in BD_Global.jsn changes"},
  {"waitForm": true},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "flight 1: pack 1"},
  {"setSensor": "Capacity", "value": 0},
  {"setInput": "SA", "value": 1},
  {"waitForm": true, "timeout": "5s"},
  {"focus": 1},
  {"key": "KEY_ENTER"},
  {"waitAudio": "selected_battery"},
  {"waitClosed": true},
  {"setSensor": "Capacity", "value": 260},
  {"waitAudio": "Lang/en/Low_Battery", "timeout": "5s"},
  {"setSensor": "Capacity", "value": 410},
  {"waitAudio": "Lang/en/low_battery_land_now", "timeout": "5s"},

  {"log": "off and on: pack 1 has 41"},
  {"restartApp": "DFM-Batt"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 41},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "contains": "\"lastBattery\":1"},

  {"log": "flight 2: pack 2, on a fresh pack (the sensor starts at 0 again)"},
  {"setSensor": "Capacity", "value": 0},
  {"waitForm": true, "timeout": "5s"},
  {"focus": 2},
  {"key": "KEY_ENTER"},
  {"waitAudio": "selected_battery"},
  {"waitClosed": true},
  {"setSensor": "Capacity", "value": 260},
  {"waitAudio": "Lang/en/Low_Battery", "timeout": "5s"},
  {"setSensor": "Capacity", "value": 410},
  {"waitAudio": "Lang/en/low_battery_land_now", "timeout": "5s"},
  {"restartApp": "DFM-Batt"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 41},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.2.cyc", "value": 8},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "contains": "\"lastBattery\":2"},

  {"log": "flight 3: both packs in parallel (+Batt on pack 1, Enter on pack 2): one cycle each"},
  {"setSensor": "Capacity", "value": 0},
  {"waitForm": true, "timeout": "5s"},
  {"focus": 1},
  {"key": "KEY_3"},
  {"focus": 2},
  {"key": "KEY_ENTER"},
  {"waitAudio": "selected_battery"},
  {"waitClosed": true},
  {"setSensor": "Capacity", "value": 260},
  {"waitAudio": "Lang/en/Low_Battery", "timeout": "5s"},
  {"restartApp": "DFM-Batt"},
  {"wait": 500},

  {"log": "the day's history: 40+2, 7+2, the glider's 9 and every other field as they were"},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 42},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.2.cyc", "value": 9},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2.1.cyc", "value": 9},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array", "count": 2},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1", "count": 2},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2", "count": 1},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cap", "value": 500},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.warn", "value": 50},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.warn2", "value": 20},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.2.cap", "value": 500},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2.1.cap", "value": 2200},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2.1.warn", "value": 30},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2.1.warn2", "value": 0},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Name.1", "value": "Field"},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Name.2", "value": "Glider"},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "contains": "\"lastGroupName\":\"Field\""}
 ]}
