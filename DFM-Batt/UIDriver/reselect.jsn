{"config": {"stepGap": 200, "stopOnFail": false},
 "steps": [
  {"log": "Settings > Re-select battery, for a second flight without switching the TX off (fixture batt-26: group Field, pack 1 has 40 cycles, pack 2 has 7). The model must keep its group, the choice must open again, the second pack gets one cycle (the first none more), and both warnings must sound again for it"},
  {"waitForm": true},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "flight 1: pack 1, both warnings"},
  {"setSensor": "Capacity", "value": 0},
  {"setInput": "SA", "value": 1},
  {"waitForm": true, "timeout": "5s"},
  {"focus": 1},
  {"key": "KEY_ENTER"},
  {"waitAudio": "selected_battery"},
  {"waitClosed": true},
  {"setSensor": "Capacity", "value": 260},
  {"waitAudio": "Lang/en/Low_Battery", "timeout": "5s"},
  {"setSensor": "Capacity", "value": 410},
  {"waitAudio": "Lang/en/low_battery_land_now", "timeout": "5s"},

  {"log": "landed; the pilot opens Batt's menu: Settings > Re-select battery"},
  {"openForm": "DFM-Batt"},
  {"waitForm": true, "timeout": "5s"},
  {"waitSub": 1},
  {"link": "Settings>>"},
  {"waitSub": 3},
  {"link": "Re-select battery"},
  {"waitSub": 3},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"log": "the choice opens again as the menu closes (no waitClosed: no frame without a form), on the model's group, with pack 1 at 41"},
  {"key": "KEY_ESC"},
  {"waitForm": true, "timeout": "5s"},
  {"wait": 300},
  {"expect": "#1", "contains": "Batt 1  [Cap 500"},
  {"expect": "#1", "contains": "Cyc 41]"},

  {"log": "flight 2: a fresh pack 2 (the sensor starts at 0 again)"},
  {"setSensor": "Capacity", "value": 0},
  {"focus": 2},
  {"key": "KEY_ENTER"},
  {"waitAudio": "selected_battery"},
  {"waitClosed": true},
  {"setSensor": "Capacity", "value": 260},
  {"waitAudio": "Lang/en/Low_Battery", "timeout": "5s"},
  {"setSensor": "Capacity", "value": 410},
  {"waitAudio": "Lang/en/low_battery_land_now", "timeout": "5s"},

  {"log": "off: pack 1 41, pack 2 8, the model on Field with pack 2 last"},
  {"restartApp": "DFM-Batt"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 41},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.2.cyc", "value": 8},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2.1.cyc", "value": 9},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "path": "lastGroup", "value": 1},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "path": "lastBattery", "value": 2}
 ]}
