{"config": {"stepGap": 200, "stopOnFail": false},
 "steps": [
  {"log": "Two models share BD_Global.jsn (fixture batt-26): TestMX uses group Field, Other uses Glider. Each model saves the whole table when it stops, so each must save the other's cycles too. TestMX flies pack 1 (40 -> 41), the pilot changes to Other and flies the glider pack (9 -> 10), then to a new model with no Batt file, then back to TestMX: every count kept, each model keeps its own group"},
  {"waitForm": true},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "TestMX flies Field pack 1"},
  {"setSensor": "Capacity", "value": 0},
  {"setInput": "SA", "value": 1},
  {"waitForm": true, "timeout": "5s"},
  {"focus": 1},
  {"key": "KEY_ENTER"},
  {"waitAudio": "selected_battery"},
  {"waitClosed": true},
  {"setSensor": "Capacity", "value": 260},
  {"waitAudio": "Lang/en/Low_Battery", "timeout": "5s"},

  {"log": "change to model Other: TestMX saves (41), Other reads the table with 41"},
  {"restartApp": "DFM-Batt", "model": "Other"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 41},
  {"setSensor": "Capacity", "value": 0},
  {"waitForm": true, "timeout": "5s"},
  {"wait": 300},
  {"expect": "#1", "contains": "Batt 1  [Cap 2200"},
  {"focus": 1},
  {"key": "KEY_ENTER"},
  {"waitAudio": "selected_battery"},
  {"waitClosed": true},

  {"log": "change to a new model with no Batt file: it reads the table, saves it unchanged, and gets a file with no group"},
  {"restartApp": "DFM-Batt", "model": "New"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 41},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2.1.cyc", "value": 10},
  {"expectFile": "Apps/DFM-Batt/BD_Other.jsn", "path": "lastGroup", "value": 2},
  {"expectFile": "Apps/DFM-Batt/BD_Other.jsn", "path": "lastBattery", "value": 1},
  {"expectFile": "Apps/DFM-Batt/BD_New.jsn", "absent": true},
  {"waitForm": true, "timeout": "5s"},
  {"key": "KEY_ESC"},
  {"answer": true},
  {"waitClosed": true},

  {"log": "back to TestMX"},
  {"restartApp": "DFM-Batt", "model": "TestMX"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_New.jsn", "path": "lastGroup", "value": 0},
  {"waitForm": true, "timeout": "5s"},
  {"wait": 300},
  {"expect": "#1", "contains": "Batt 1  [Cap 500"},
  {"expect": "#1", "contains": "Cyc 41]"},
  {"key": "KEY_ESC"},
  {"answer": true},
  {"waitClosed": true},
  {"restartApp": "DFM-Batt"},
  {"wait": 500},

  {"log": "after all four: the whole table as it should be, and each model's own group"},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 41},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.2.cyc", "value": 7},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2.1.cyc", "value": 10},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array", "count": 2},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Name.1", "value": "Field"},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Name.2", "value": "Glider"},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "path": "lastGroup", "value": 1},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "path": "lastGroupName", "value": "Field"},
  {"expectFile": "Apps/DFM-Batt/BD_Other.jsn", "path": "lastGroup", "value": 2},
  {"expectFile": "Apps/DFM-Batt/BD_Other.jsn", "path": "lastGroupName", "value": "Glider"},
  {"expectFile": "Apps/DFM-Batt/BD_Other.jsn", "path": "battmAhSePa", "value": 6}
 ]}
