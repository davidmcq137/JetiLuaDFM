{"config": {"stepGap": 200, "stopOnFail": false},
 "steps": [
  {"log": "Settings > Clear all model settings (fixture batt-26): this model's file goes, and stays gone over the restart it asks for; the battery table (every pack's cycles) and the other model's file stay. After the restart the model starts fresh: no group, no sensor"},
  {"waitForm": true},
  {"waitSub": 1},
  {"link": "Settings>>"},
  {"waitSub": 3},
  {"link": "Clear all model settings"},
  {"waitSub": 3},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "absent": true},

  {"log": "restart (as the message asks): the model's file is not written back"},
  {"restartApp": "DFM-Batt"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "absent": true},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 40},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.2.cyc", "value": 7},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.2.1.cyc", "value": 9},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Name.1", "value": "Field"},
  {"expectFile": "Apps/DFM-Batt/BD_Other.jsn", "path": "lastGroup", "value": 2},

  {"log": "the fresh model: no group, no sensor; the next stop saves that"},
  {"openForm": "DFM-Batt"},
  {"waitForm": true, "timeout": "5s"},
  {"waitSub": 1},
  {"link": "Model Battery Group>>"},
  {"waitSub": 2},
  {"expect": "#1", "value": 0},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"restartApp": "DFM-Batt"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "path": "lastGroup", "value": 0},
  {"expectFile": "Apps/DFM-Batt/BD_TestMX.jsn", "path": "battmAhSe", "value": 0},
  {"expectFile": "Apps/DFM-Batt/BD_Global.jsn", "path": "Array.1.1.cyc", "value": 40}
 ]}
