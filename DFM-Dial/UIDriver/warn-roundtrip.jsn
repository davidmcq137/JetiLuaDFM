{"config": {"stepGap": 200, "stopOnFail": false},
 "steps": [
  {"log": "Dial's min/max warnings across a restart. Each window's warnings are arrays of 4 where nil means 'no warning'. A warning on dial 2 only makes {nil, 5.0}, which JETI's json (Lua CJSON) saves as [null,5]; on reading back the null is a lightuserdata, truthy, and arithmetic on it is an error. Window 1 gets two dials, a max warning on dial 2 only, then Dial is restarted (destroy saves, init reads) and both sensors are driven past their limits"},
  {"waitForm": true},
  {"waitSub": 1},
  {"set": "1", "value": "Full Screen (2)"},
  {"focus": 1},
  {"key": "KEY_3"},
  {"waitSub": 13},
  {"set": "Sensor 1:", "value": "IBP 2S LiFe-> SOC P5"},
  {"set": "Sensor 2:", "value": "IBP 2S LiFe-> Pack P8"},
  {"focus": 2},
  {"key": "KEY_3"},
  {"waitSub": 103},
  {"set": "Maximum warning value", "value": 50},
  {"key": "KEY_ESC"},
  {"waitSub": 13},
  {"key": "KEY_ESC"},
  {"waitSub": 1},
  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "restart: destroy writes DD_DialTest.jsn, init reads it back. The file shows the hole as null; Dial's repair at init (DFM-Dial.lua:1186) prints 'fix max 1 1 userdata'"},
  {"restartApp": "DFM-Dial"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Dial/DD_DialTest.jsn", "contains": "\"sensorMaxWarn\":[null,5]"},

  {"log": "in flight: SOC (no warning) and Pack (warning at 5) both over range"},
  {"setSensor": "SOC P5", "value": 50},
  {"setSensor": "Pack P8", "value": 8},
  {"waitTelem": 1},
  {"wait": 3000},

  {"log": "a second restart: Dial's repair at init turned the userdata back into nil, so the hole is saved as null again; Dial must still start and run without an error"},
  {"restartApp": "DFM-Dial"},
  {"wait": 500},
  {"expectFile": "Apps/DFM-Dial/DD_DialTest.jsn", "contains": "\"sensorMaxWarn\":[null,5]"},
  {"waitTelem": 1},
  {"wait": 3000}
 ]}
