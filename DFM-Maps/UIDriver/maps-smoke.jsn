{"steps": [
  {"log": "DFM-Maps smoke test, part 1: open DFM-Maps from the Applications menu"},
  {"waitForm": true},
  {"waitSub": 1},
  {"expectState": "maps"},
  {"waitMessage": "Current location", "anyTime": true},

  {"link": "Telemetry Sensors >>"},
  {"waitSub": 2},
  {"link": "<<< Back to main menu"},
  {"waitSub": 1},

  {"log": "map browser pass 1 (with a visual check); assumes the field has at least 2 zoom images"},
  {"link": "Map Browser >>"},
  {"waitSub": 7},
  {"cpuStart": true},
  {"button": "Show"},
  {"waitEvent": "imageLoaded"},
  {"expectSub": 10},
  {"expectState": "maps.currentImage", "value": 1},
  {"dumpText": true},
  {"remember": "maps.imageFile", "as": "img1"},
  {"expectText": "$img1", "region": [0, 0, 480, 40]},
  {"expectImage": "$img1", "exact": true},
  {"key": "KEY_4"},
  {"waitEvent": "imageLoaded"},
  {"expectState": "browse.Idx", "value": 2},
  {"expectState": "maps.currentImage", "value": 2},
  {"remember": "maps.imageFile", "as": "img2"},
  {"expectText": "$img2", "region": [0, 0, 480, 40]},
  {"expectNoText": "$img1", "exact": true},
  {"expectImage": "$img2", "exact": true},
  {"expectNoImage": "$img1", "exact": true},
  {"confirm": "Is the map now zoomed in one step from the first image?"},
  {"key": "KEY_3"},
  {"waitEvent": "imageLoaded"},
  {"expectState": "browse.Idx", "value": 1},
  {"expectState": "browse.decodes", "value": 2},
  {"log": "zoom key burst: three KEY_4 100 ms apart (under DFM-Maps' 350 ms settle time) decode only the level the keys stop on (levels 1 and 2 are already decoded, so at most 3 decodes in all)"},
  {"key": "KEY_4", "gap": 100},
  {"key": "KEY_4", "gap": 100},
  {"key": "KEY_4"},
  {"waitEvent": "imageLoaded"},
  {"expectState": "browse.decodes", "max": 3},
  {"key": "KEY_1"},
  {"waitSub": 7},
  {"cpuCheck": true},
  {"link": "<<< Back to main menu"},
  {"waitSub": 1},

  {"repeat": 2, "steps": [
    {"link": "Map Browser >>"},
    {"waitSub": 7},
    {"cpuStart": true},
    {"button": "Show"},
    {"waitEvent": "imageLoaded"},
    {"expectSub": 10},
    {"key": "KEY_4"},
    {"waitEvent": "imageLoaded"},
    {"expectState": "browse.Idx", "value": 2},
    {"key": "KEY_3"},
    {"waitEvent": "imageLoaded"},
    {"expectState": "browse.Idx", "value": 1},
    {"key": "KEY_1"},
    {"waitSub": 7},
    {"cpuCheck": true},
    {"link": "<<< Back to main menu"},
    {"waitSub": 1}
  ]},

  {"key": "KEY_ESC"},
  {"waitClosed": true},

  {"log": "part 2: show the DFM-Maps Map View telemetry window full screen (no key presses needed)"},
  {"waitTelem": 1},
  {"note": "Press ESC now so the map view's own buttons (- + NoFly NFAnn NFShk) show; the script can't switch them, only the firmware can. Then watch NoFly, NFAnn and NFShk change", "ms": 10000},
  {"dumpText": true, "win": 1},
  {"expectText": "N", "exact": true, "win": 1},
  {"expectText": "Alt:", "win": 1},
  {"expectText": "Spd:", "win": 1},
  {"log": "Mag: and Width: (with CPU and P/D) are drawn only with the 458 px maps"},
  {"expectText": "Mag:", "win": 1, "onlyIf": {"state": "maps.imageWidth", "value": 458}},
  {"expectText": "Width:", "win": 1, "onlyIf": {"state": "maps.imageWidth", "value": 458}},
  {"log": "pylons: these need triangle racing on for this field"},
  {"expectText": "1", "exact": true, "win": 1},
  {"expectText": "2", "exact": true, "win": 1},
  {"expectText": "3", "exact": true, "win": 1},
  {"log": "the button steps need telemetry buttons (none on DS-24 fw 5.08): skipped without them"},
  {"expectTelemButton": "-", "state": "enabled", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectTelemButton": "+", "state": "enabled", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectTelemButton": "NoFly", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"remember": "checkBox.noflyEnabled", "as": "nf", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"telemButton": "NoFly", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectState": "checkBox.noflyEnabled", "notValue": "$nf", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectTelemButton": "NoFly", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectTelemButton": 4, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectTelemButton": 5, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"telemButton": "NoFly", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectState": "checkBox.noflyEnabled", "value": "$nf", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectTelemButton": "NoFly", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectTelemButton": 4, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectTelemButton": 5, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"log": "smoke test finished; NoFly is back where it started"}
]}
