{"steps": [
  {"log": "DFM-Maps no-fly test: field BDS458 or BDS320 (the same field, 458 or 320 px maps), polygon 1. Needs SensorE running with the DFM-Maps config; open DFM-Maps from the Applications menu"},
  {"waitForm": true},
  {"waitSub": 1},
  {"waitMessage": "Maps: ", "anyTime": true},
  {"expectState": "maps.activeField", "oneOf": ["BDS458", "BDS320"]},
  {"expectState": "noFly.polygons", "value": 2},

  {"log": "turn on no-fly display, announcements and stick shake (this test leaves them on)"},
  {"link": "Settings >>"},
  {"waitSub": 6},
  {"set": "Show No Fly Zones", "value": true},
  {"set": "Announce No Fly Entry/Exit", "value": true},
  {"set": "Stick Shake on No Fly Entry", "value": true},
  {"link": "<<< Back to main menu"},
  {"waitSub": 1},
  {"log": "DFM-Maps does no GPS or no-fly work while its form is open: close it"},
  {"key": "KEY_ESC"},
  {"waitClosed": true},
  {"log": "show the DFM-Maps Map View telemetry window full screen, to watch (and so NFAnn can be pressed)"},
  {"waitTelem": 1},

  {"log": "freeze SensorE, speed 0 so the projected (future) position is the current one"},
  {"setInput": "P8", "value": -1},
  {"sensorPause": true},

  {"log": "start outside: SensorE's origin, 38 m west of the zone"},
  {"sensorPosition": {"lat": "41.340050", "lon": "-74.430933"}},
  {"wait": 2000},
  {"expectState": "noFly.inside", "value": false},

  {"log": "into the zone: its centroid"},
  {"sensorPosition": {"lat": "41.339985035", "lon": "-74.429830046"}},
  {"waitAudio": "warning_no_fly_zone"},
  {"waitVibration": "left", "profile": 3},
  {"expectState": "noFly.inside", "value": true},

  {"log": "move within the zone, 3 m inside the north edge: no announcement"},
  {"sensorPosition": {"lat": "41.340369490", "lon": "-74.429794690", "north": -3}},
  {"waitAudio": "no_fly", "absent": true, "for": "3s"},
  {"waitVibration": true, "absent": true, "for": 500},
  {"expectState": "noFly.inside", "value": true},

  {"log": "out, 3 m beyond the north edge"},
  {"sensorPosition": {"lat": "41.340369490", "lon": "-74.429794690", "north": 3}},
  {"waitAudio": "leaving_no_fly_zone"},
  {"expectState": "noFly.inside", "value": false},

  {"log": "back in across the north edge (6 m step)"},
  {"sensorPosition": {"lat": "41.340369490", "lon": "-74.429794690", "north": -3}},
  {"waitAudio": "warning_no_fly_zone"},
  {"waitVibration": "left", "profile": 3},

  {"log": "out across the east edge, 3 m beyond it"},
  {"sensorPosition": {"lat": "41.339862375", "lon": "-74.429253371", "east": 3}},
  {"waitAudio": "leaving_no_fly_zone"},
  {"expectState": "noFly.inside", "value": false},

  {"log": "the NFAnn steps need telemetry buttons (none on DS-24 fw 5.08): skipped without them"},
  {"log": "announcements off (NFAnn button): entering shakes the stick but says nothing"},
  {"telemButton": "NFAnn", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectState": "checkBox.noFlyWarningEnabled", "value": false, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"sensorPosition": {"lat": "41.339862375", "lon": "-74.429253371", "east": -3}, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"waitVibration": "left", "profile": 3, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"waitAudio": "no_fly", "absent": true, "for": "3s", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectState": "noFly.inside", "value": true, "onlyIf": {"state": "maps.telemButtons", "value": true}},

  {"log": "announcements back on; leave and let SensorE fly again"},
  {"telemButton": "NFAnn", "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"expectState": "checkBox.noFlyWarningEnabled", "value": true, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"sensorPosition": {"lat": "41.340050", "lon": "-74.430933"}, "onlyIf": {"state": "maps.telemButtons", "value": true}},
  {"waitAudio": "leaving_no_fly_zone", "onlyIf": {"state": "maps.telemButtons", "value": true}},

  {"log": "outside, close to the west corners (where the old test could double count a corner): no warning"},
  {"sensorPosition": {"lat": "41.340347521", "lon": "-74.43033357", "east": -3}},
  {"waitAudio": "no_fly", "absent": true, "for": "2s"},
  {"expectState": "noFly.inside", "value": false},
  {"sensorPosition": {"lat": "41.340347521", "lon": "-74.43033357", "east": -1}},
  {"waitAudio": "no_fly", "absent": true, "for": "2s"},
  {"expectState": "noFly.inside", "value": false},
  {"sensorPosition": {"lat": "41.339867869", "lon": "-74.430479872", "east": -3}},
  {"waitAudio": "no_fly", "absent": true, "for": "2s"},
  {"expectState": "noFly.inside", "value": false},
  {"sensorPosition": {"lat": "41.339867869", "lon": "-74.430479872", "east": -1}},
  {"waitAudio": "no_fly", "absent": true, "for": "2s"},
  {"expectState": "noFly.inside", "value": false},
  {"sensorPosition": false},
  {"clearInput": "P8"},
  {"sensorPause": false},
  {"log": "no-fly test finished"}
]}
